{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/yahoo/(.*)",
      "destination": "https://query1.finance.yahoo.com/$1"
    },
    {
      "source": "/api/upstox/(.*)",
      "destination": "https://api.upstox.com/$1"
    },
    {
      "source": "/api/groq/(.*)",
      "destination": "https://api.groq.com/$1"
    },
    {
      "source": "/api/finnhub/(.*)",
      "destination": "https://finnhub.io/$1"
    },
    {
      "source": "/api/newsapi/(.*)",
      "destination": "https://newsapi.org/$1"
    },
    {
      "source": "/api/gdelt/(.*)",
      "destination": "https://api.gdeltproject.org/$1"
    },
    {
      "source": "/((?!api/|_vercel/|[a-f0-9]{16}/event|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
